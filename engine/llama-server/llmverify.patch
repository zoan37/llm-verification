+    // The rule's choice from the same top-20 that populate_token_probs reports (pre-sampling), as committed: the
+    // reported logprob is logarithm(p) of the float softmax, rounded to 1e-4 by the client and by the rule alike.
+    static llama_token llmverify_choose(llama_context * ctx, int idx, const llmverify::verify_params & v, int step) {
+        const std::vector<llama_token_data> cur = get_token_probabilities(ctx, idx, llmverify::COMMIT_K);
+        std::vector<std::pair<int, double>> raw;
+        for (size_t i = 0; i < std::min(cur.size(), (size_t) llmverify::COMMIT_K); i++) {
+            raw.emplace_back(cur[i].id, (double) completion_token_output::logarithm(cur[i].p));
+        }
+        return llmverify::rule_choose(llmverify::round_top(raw), v.spec, v.key, step);
+    }
